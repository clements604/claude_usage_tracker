{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify attention" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify attention" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify attention" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify clear" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify clear" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "async": true, "command": "~/.local/bin/claude-ticker-notify clear" }
        ]
      }
    ]
  }
}
